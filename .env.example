# Flask
SECRET_KEY=change-me-to-a-long-random-string

# Database (defaults to SQLite at ./app.db)
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/ad_security

# Optional SMTP for password reset / notifications
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@adsecurity.example
MAIL_USE_TLS=1
MAIL_USE_SSL=0

# Dev server port
PORT=5000